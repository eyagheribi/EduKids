{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameSessions": {
    "MaxAttempts": 3,
    "InactivityTimeoutMinutes": 5,
    "FailureCooldownHours": 24,
    "ExpirationPollingIntervalSeconds": 15
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "ConnectionTimeoutSeconds": 5,
    "PublisherConfirmTimeoutSeconds": 10
  }
}
